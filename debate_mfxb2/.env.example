# ============================================================
# 数字法庭后端环境变量模板
# ------------------------------------------------------------
# 用法：
#   cp .env.example .env
#   按需修改 LLM / 追踪 / 数据库 / MinIO 密钥
# ------------------------------------------------------------
# 默认值面向 docker-compose 容器网络（postgres:5432 / minio:9000）；
# 本地开发（uvicorn 直接跑在宿主机）请把 postgres / minio 改回 localhost。
# docker-compose 会在 environment 中强制覆盖 DATABASE_URL/MINIO_*，
# 因此 .env 中的本地值不会影响容器内运行。
# ============================================================

# ==================== LLM API 配置 (OpenAI 兼容) ====================
OPENAI_API_BASE=https://openapi.coreshub.cn/v1
OPENAI_API_KEY=your-api-key-here
MODEL_NAME=DeepSeek-V4-Flash

# ==================== LangSmith 追踪 ====================
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_PROJECT=debate_mfxb2

# ==================== PostgreSQL ====================
# 容器网络（默认）：postgresql+asyncpg://postgres:court123@postgres:5432/court_system
# 本地开发：postgresql+asyncpg://postgres:court123@localhost:5432/court_system
DATABASE_URL=postgresql+asyncpg://postgres:court123@postgres:5432/court_system
POSTGRES_USER=postgres
POSTGRES_PASSWORD=court123
POSTGRES_DB=court_system

# ==================== MinIO 对象存储 ====================
# 容器网络（默认）：minio:9000
# 本地开发：localhost:9000
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minio123
MINIO_BUCKET=court-cases
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minio123
